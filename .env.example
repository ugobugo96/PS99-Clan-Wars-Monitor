# Create a bot at https://discord.com/developers/applications and keep this secret.
DISCORD_TOKEN=replace-with-your-bot-token

# Required Discord text channel snowflake for war notifications.
NOTIFICATION_CHANNEL_ID=123456789012345678

# Required Roblox experience (universe) ID for Pet Simulator 99.
# Find the correct ID from the experience owner/Roblox URL; do not use a place ID here.
PS99_UNIVERSE_ID=replace-with-the-verified-universe-id

# Optional settings
DATABASE_PATH=data/ps99_bot.sqlite3
POLL_INTERVAL_SECONDS=45
DISCONNECT_CONFIRMATION_CHECKS=2
PRESENCE_BATCH_SIZE=50
LOG_LEVEL=INFO
